@model Authentic_Api.Models.ViewModels.UserSoftwareViewModel

@{
    ViewBag.Title = "AccessSoftware";
}

<h2>Usuário</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.User.Id)

        <div class="form-group">
            <div class="col-md-10">
                <h4>
                    @Html.DisplayFor(model => model.User.Name)
                    @Html.DisplayFor(model => model.User.NickName)
                </h4>
            </div>
        </div>
        <div class="form-group">
            <small>
                <i>Selecione o Sistema para ajustar acessos</i>
            </small>
            <div class="accordion" id="accordionExample">
                @for (int i = 0; i < Model.Softwares.Count; i++)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading_@i">
                            <button class="accordion-button  collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@i" aria-expanded="false" aria-controls="collapse_@i">
                                @Html.DisplayFor(model => Model.Softwares[i].Software.Name)
                            </button>
                            @Html.HiddenFor(model => model.Softwares[i].Software.Id)
                            @Html.HiddenFor(model => model.Softwares[i].Software.Name)
                        </h2>
                        <div id="collapse_@i" class="accordion-collapse collapse" aria-labelledby="heading_@i" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                @for (int j = 0; j < Model.Softwares[i].Roles.Count; j++)
                                {
                                    <label class="checkbox col-12 col-sm-6 col-lg-3" title="@Html.DisplayFor(model => Model.Softwares[i].Roles[j].Name)">
                                        @Html.HiddenFor(model => model.Softwares[i].Roles[j].Id)
                                        @Html.EditorFor(model => model.Softwares[i].Roles[j].IsChecked)
                                        @Html.DisplayFor(model => model.Softwares[i].Roles[j].Name)
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="form-group">
            <div class="mt-2 col-md-10">
                @Html.ActionLink("Voltar", "Index", null, new { @class = "btn btn-secondary" })
                <input type="submit" value="Atualizar" class="btn btn-primary" />
            </div>
        </div>
    </div>
}
