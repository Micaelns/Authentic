@model IEnumerable<Authentic_Api.Models.ViewModels.SoftwareViewModel>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Novo Software", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
            <a href="@Url.RouteUrl("SoftwareRoles",new { softwareId=item.Id , action = "Index"})"
               class="btn btn-outline-primary btn-sm"
               title="Acessos">
                <i class="bi bi-file-earmark-person"></i>
            </a>
            <a href="@Url.Action("Edit","Software", new { id = item.Id })"
               class="btn btn-outline-secondary btn-sm"
               title="Editar">
                <i class="bi bi-pencil-square"></i>
            </a>
            <a href="@Url.Action("Details","Software", new { id = item.Id })"
               class="btn btn-outline-info btn-sm"
               title="Detalhes">
                <i class="bi bi-eye"></i>
            </a>
            <a href="@Url.Action("Delete","Software", new { id = item.Id })"
               class="btn btn-outline-danger btn-sm"
               title="Deletar">
                <i class="bi bi-trash"></i>
            </a>
        </td>
    </tr>
}

</table>
