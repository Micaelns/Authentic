@model Authentic_Api.Models.ViewModels.SoftwareRolesViewModel

@{
    ViewBag.Title = "Index";
}

<h2>@Model.Software.Name</h2>
<p>
    @Html.ActionLink("Novo Role", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Roles.First().Name)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.Roles)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a href="@Url.RouteUrl("SoftwareRoles",new { softwareId=Model.Software.Id , id = item.Id, action = "Edit"})"
                   class="btn btn-outline-secondary btn-sm"
                   title="Editar">
                    <i class="bi bi-pencil-square"></i>
                </a>
                <a href="@Url.RouteUrl("SoftwareRoles",new { softwareId=Model.Software.Id , id = item.Id, action = "Details"})"
                   class="btn btn-outline-info btn-sm"
                   title="Detalhes">
                    <i class="bi bi-eye"></i>
                </a>
                <a href="@Url.RouteUrl("SoftwareRoles",new { softwareId=Model.Software.Id ,id = item.Id, action = "Delete" })"
                   class="btn btn-outline-danger btn-sm"
                   title="Deletar">
                    <i class="bi bi-trash"></i>
                </a>
            </td>
        </tr>
    }

</table>
<p>
    <a href="@Url.Action("Index", "Software")"
       class="btn btn-outline-secondary btn-sm"
       title="Softwares">
        Voltar
    </a>

</p>
